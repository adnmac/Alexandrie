    "NSRemovableVolumesUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alexandrie sendet Ihre Bücher an Ihren E-Reader und liest seine Notizen und Markierungen, wenn er angeschlossen ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Alexandrie sends your books to your e-reader and reads its notes and highlights when it is connected."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Alexandrie envía tus libros a tu lector y lee sus notas y subrayados cuando está conectado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alexandrie envoie vos livres à votre liseuse et lit ses notes et surlignages quand elle est branchée."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alexandrie stuurt je boeken naar je e-reader en leest de notities en markeringen zodra hij is aangesloten."
          }
        }
      }
