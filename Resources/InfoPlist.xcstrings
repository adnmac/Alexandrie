{
  "sourceLanguage": "fr",
  "strings": {
    "NSDesktopFolderUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alexandrie liest die Bücher Ihrer Bibliothek auf dem Schreibtisch, ohne sie zu verändern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Alexandrie reads the books in your library stored on the Desktop, without changing them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Alexandrie lee los libros de tu biblioteca guardados en el Escritorio, sin modificarlos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alexandrie lit les livres de votre bibliothèque rangés sur le Bureau, sans les modifier."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alexandrie leest de boeken uit je bibliotheek die op het bureaublad staan, zonder ze te wijzigen."
          }
        }
      }
    },
