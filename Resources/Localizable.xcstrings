    "Ces dossiers sont lus sans jamais être modifiés. Les livres importés, les couvertures et les conversions sont stockés dans le dossier de l'app." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Ordner werden gelesen, ohne je verändert zu werden. Importierte Bücher, Cover und Umwandlungen liegen im Ordner der App."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "These folders are read without ever being changed. Imported books, covers and conversions are stored in the app's folder."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estas carpetas se leen sin modificarse nunca. Los libros importados, las portadas y las conversiones se guardan en la carpeta de la app."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze mappen worden gelezen zonder ze ooit te wijzigen. Geïmporteerde boeken, omslagen en omzettingen staan in de map van de app."
          }
        }
      }
    },
