    "Catalogues OPDS publics de livres gratuits. Rien n'est demandé en ligne tant qu'un catalogue n'est pas ouvert dans la barre latérale ; seuls les livres sans DRM peuvent être ajoutés." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffentliche OPDS-Kataloge mit kostenlosen Büchern. Es wird nichts online abgefragt, solange kein Katalog in der Seitenleiste geöffnet ist; nur Bücher ohne DRM können hinzugefügt werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Public OPDS catalogs of free books. Nothing is requested online until a catalog is opened in the sidebar; only DRM-free books can be added."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catálogos OPDS públicos de libros gratuitos. No se consulta nada en línea mientras no se abra un catálogo en la barra lateral; solo se pueden añadir libros sin DRM."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Openbare OPDS-catalogi met gratis boeken. Er wordt niets online opgevraagd zolang er geen catalogus in de navigatiekolom is geopend; alleen boeken zonder DRM kunnen worden toegevoegd."
          }
        }
      }
    },
    "Catalogues en ligne" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Online-Kataloge"
          }
