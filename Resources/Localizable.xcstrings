          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A transfer is in progress: wait for it to finish before ejecting the e-reader."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hay una transferencia en curso: espera a que termine antes de expulsar el lector."
          }
        },
