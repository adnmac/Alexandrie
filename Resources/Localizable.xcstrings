    "%lld livres quittent la bibliothèque, avec leur place sur les étagères et dans l'attente d'envoi. Les fichiers restent sur le disque." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld Bücher verlassen die Bibliothek, samt ihrem Platz in den Regalen und in der Warteschlange. Die Dateien bleiben auf dem Laufwerk."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld books leave the library, along with their place on shelves and in the send queue. The files stay on disk."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld libros salen de la biblioteca, con su lugar en las estanterías y en la cola de envío. Los archivos siguen en el disco."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld boeken verlaten de bibliotheek, met hun plaats op de boekenplanken en in de wachtrij. De bestanden blijven op de schijf."
          }
        }
      }
    },
    "%lld livres sont indisponibles : leur dossier de livres est introuvable (disque débranché ?)." : {
