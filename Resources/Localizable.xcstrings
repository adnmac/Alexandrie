      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS hat Foluna %lld Absturzberichte übergeben. Sie zu senden hilft, das Problem zu beheben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS gave Foluna %lld crash reports. Sending them helps fix the problem."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS ha entregado a Foluna %lld informes de fallo. Enviarlos ayuda a corregir el problema."
