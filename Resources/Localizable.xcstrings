    },
    "La recherche ignore les accents et les majuscules ; le dernier mot peut être un début de mot." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Suche ignoriert Akzente und Groß- und Kleinschreibung; das letzte Wort kann ein Wortanfang sein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Search ignores accents and capitals; the last word can be the start of a word."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La búsqueda ignora acentos y mayúsculas; la última palabra puede ser el principio de una palabra."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zoeken negeert accenten en hoofdletters; het laatste woord mag het begin van een woord zijn."
          }
        }
      }
    },
    "La version téléchargée ne porte pas la signature attendue (%d) : elle n'a pas été installée." : {
