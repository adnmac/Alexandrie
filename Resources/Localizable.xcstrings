    "%@ : disque débranché ou dossier déplacé. La sauvegarde reprendra quand il sera de retour." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: Laufwerk getrennt oder Ordner verschoben. Die Sicherung wird fortgesetzt, sobald er wieder da ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: disk unplugged or folder moved. Backups will resume when it is back."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: disco desconectado o carpeta movida. La copia de seguridad continuará cuando vuelva."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: schijf losgekoppeld of map verplaatst. De reservekopie gaat verder zodra die terug is."
