    "Zotero redemandera l'autorisation au prochain envoi ; elle se retire aussi dans Zotero (Réglages › Avancés)" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zotero fragt beim nächsten Senden erneut nach der Berechtigung; sie lässt sich auch in Zotero entziehen (Einstellungen › Erweitert)"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zotero will ask for permission again at the next send; it can also be removed in Zotero (Settings › Advanced)"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zotero volverá a pedir permiso en el próximo envío; también se puede retirar en Zotero (Ajustes › Avanzado)"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zotero vraagt bij de volgende verzending opnieuw om toestemming; je kunt die ook in Zotero intrekken (Instellingen › Geavanceerd)"
          }
        }
      }
    },
