          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Create a topic to file your highlights and name its colors: yellow = construction, blue = cost analysis…"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crea un tema para clasificar tus subrayados y nombrar sus colores: amarillo = construcción, azul = análisis de costes…"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maak een thema om je markeringen in te delen en de kleuren een naam te geven: geel = bouw, blauw = kostenanalyse…"
          }
        }
      }
    },
    "Dans Zotero, cochez Réglages › Avancés › « Autoriser d'autres applications de cet ordinateur à communiquer avec Zotero »." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktivieren Sie in Zotero Einstellungen › Erweitert › „Anderen Anwendungen auf diesem Computer die Kommunikation mit Zotero erlauben“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In Zotero, check Settings › Advanced › “Allow other applications on this computer to communicate with Zotero”."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En Zotero, activa Ajustes › Avanzado › «Permitir que otras aplicaciones de este ordenador se comuniquen con Zotero»."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vink in Zotero Instellingen › Geavanceerd › ‘Andere apps op deze computer laten communiceren met Zotero’ aan."
          }
        }
      }
    },
