    " dans la Corbeille de macOS et ces livres quitteront Foluna. Ils resteront récupérables " : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " in den macOS-Papierkorb gelegt, und diese Bücher verlassen Foluna. Sie lassen sich wiederherstellen, "
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " to the macOS Trash and these books will leave Foluna. They can be recovered "
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " a la Papelera de macOS y estos libros saldrán de Foluna. Se podrán recuperar "
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " naar de macOS-prullenmand en deze boeken verlaten Foluna. Ze blijven herstelbaar "
          }
        }
      }
    },
    " dans la Corbeille de macOS et le livre quittera Foluna. Les fichiers resteront récupérables " : {
